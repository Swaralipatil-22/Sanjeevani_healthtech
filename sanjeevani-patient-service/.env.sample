# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
SERVICE_BASE_PATH=/patient-service
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTNAMES=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanjeevani
DB_USERNAME=sanjeevani
DB_PASSWORD=sanjeevani
DB_SCHEMA=public
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_LOGGING=false
DB_SYNC=true
DB_SEED=true

# ---------------------------------------------------------------------------
# CRYPTOGRAPHY / AUTH
# ---------------------------------------------------------------------------
# 32-character key and 16-character IV are required for AES-256-CBC.
AES_ENCRYPTION_KEY=sanjeevani_dev_aes_key_32_chars!
AES_ENCRYPTION_IV=sanjeevani_dev16
JWT_SECRET_KEY=sanjeevani_dev_jwt_secret_change_me
JWT_ISSUER=Sanjeevani
JWT_AUDIENCE=Sanjeevani
JWT_EXPIRY_IN_SECONDS=10800
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_HTTP_LOGGING=true

# ---------------------------------------------------------------------------
# RATE LIMITING
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_IN_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# ---------------------------------------------------------------------------
# SEED ACCOUNTS (created only when DB_SEED=true)
# ---------------------------------------------------------------------------
SEED_DEFAULT_PASSWORD=Sanjeevani@123
